            opacity: 0.6;
            cursor: pointer;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            transition: all 0.3s ease;
        }

        .comment-action:hover {
            opacity: 1;
            color: var(--aged-gold);
