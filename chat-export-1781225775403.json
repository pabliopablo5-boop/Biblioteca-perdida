            padding-top: 2rem;
            border-top: 1px solid rgba(201, 169, 97, 0.2);
            text-align: center;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--ivory);
            opacity: 0.5;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 2rem;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.3);
            border-radius: 8px;
            max-width: 800px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
        }

        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: none;
            border: none;
            color: var(--ivory);
            font-size: 1.5rem;
            cursor: pointer;
            z-index: 10;
            transition: all 0.3s ease;
        }

        .modal-close:hover {
            color: var(--aged-gold);
            transform: rotate(90deg);
        }

        .modal-body {
            padding: 3rem;
        }

        /* Responsive */
        @media (max-width: 992px) {
            .magazine-featured {
                grid-template-columns: 1fr;
            }

