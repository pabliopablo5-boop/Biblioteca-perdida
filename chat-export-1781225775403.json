        ];

        // Initialize Background Embers
        function initEmbers() {
            const bgAnimation = document.getElementById('bgAnimation');
            for (let i = 0; i < 20; i++) {
                const ember = document.createElement('div');
                ember.className = 'ember';
                ember.style.left = Math.random() * 100 + '%';
                ember.style.animationDelay = Math.random() * 8 + 's';
                ember.style.animationDuration = (6 + Math.random() * 4) + 's';
                bgAnimation.appendChild(ember);
            }
        }

        // Render Works
        function renderWorks(filter = 'all') {
            const grid = document.getElementById('libraryGrid');
            const filteredWorks = filter === 'all' 
                ? works 
                : works.filter(work => work.category === filter);
            
            grid.innerHTML = filteredWorks.map(work => `
                <div class="work-card fade-in" onclick="openWorkModal(${work.id})">
                    <img src="${work.image}" alt="${work.title}" class="work-image">
                    <div class="work-content">
                        <p class="work-category">${work.categoryLabel}</p>
                        <h3 class="work-title">${work.title}</h3>
                        <p class="work-excerpt">${work.excerpt}</p>
                        <div class="work-meta">
                            <a href="#" class="work-author" onclick="event.stopPropagation()">
                                <i class="fas fa-feather"></i>
                                ${work.author}
                            </a>
                            <div class="work-stats">
                                <span><i class="fas fa-heart"></i> ${work.likes}</span>
                                <span><i class="fas fa-comment"></i> ${work.comments}</span>
                                <span><i class="fas fa-eye"></i> ${work.reads}</span>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
            
            // Re-trigger fade-in animation
            observeElements();
        }

        // Render Authors
        function renderAuthors() {
            const grid = document.getElementById('authorsGrid');
            grid.innerHTML = authors.map(author => `
                <div class="author-card fade-in">
                    <img src="${author.avatar}" alt="${author.name}" class="author-avatar">
                    <h3 class="author-name">${author.name}</h3>
                    <p class="author-genre">${author.genre}</p>
                    <p class="author-bio">${author.bio}</p>
                    <div class="author-stats">
                        <div class="stat">
                            <p class="stat-value">${author.works}</p>
                            <p class="stat-label">Obras</p>
                        </div>
                        <div class="stat">
                            <p class="stat-value">${author.followers.toLocaleString()}</p>
                            <p class="stat-label">Seguidores</p>
                        </div>
                    </div>
                </div>
            `).join('');
            
            observeElements();
        }

        // Render Contests
        function renderContests() {
            const grid = document.getElementById('contestsGrid');
            grid.innerHTML = contests.map(contest => `
                <div class="contest-card fade-in">
                    <p class="contest-deadline">
                        <i class="fas fa-hourglass-half"></i>
                        Fecha límite: ${contest.deadline}
                    </p>
                    <h3 class="contest-title">${contest.title}</h3>
                    <p class="contest-prize"><i class="fas fa-trophy"></i> ${contest.prize}</p>
                    <p style="color: var(--ivory); opacity: 0.8; line-height: 1.8; margin-bottom: 1.5rem;">${contest.description}</p>
                    <a href="#" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i>
                        Participar
                    </a>
                </div>
            `).join('');
            
            observeElements();
        }

        // Render Comments
        function renderComments() {
            const list = document.getElementById('commentsList');
            list.innerHTML = comments.map(comment => `
                <div class="comment">
                    <img src="${comment.avatar}" alt="${comment.author}" class="comment-avatar">
                    <div class="comment-content">
                        <div class="comment-header">
                            <span class="comment-author">${comment.author}</span>
                            <span class="comment-date">${comment.date}</span>
                        </div>
                        <p class="comment-text">${comment.text}</p>
                        <div class="comment-actions">
                            <button class="comment-action">
                                <i class="fas fa-heart"></i>
                                ${comment.likes}
                            </button>
                            <button class="comment-action">
                                <i class="fas fa-reply"></i>
                                Responder
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Open Work Modal
        function openWorkModal(workId) {
            const work = works.find(w => w.id === workId);
            if (!work) return;
            
            const modal = document.getElementById('workModal');
            const modalBody = document.getElementById('modalBody');
            
            modalBody.innerHTML = `
                <img src="${work.image}" alt="${work.title}" style="width: 100%; height: 300px; object-fit: cover; border-radius: 8px; margin-bottom: 2rem;">
                <p class="work-category" style="margin-bottom: 1rem;">${work.categoryLabel}</p>
                <h2 style="font-family: var(--font-title); font-size: 2.5rem; color: var(--ivory); margin-bottom: 1rem;">${work.title}</h2>
                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid rgba(201, 169, 97, 0.2);">
                    <span style="color: var(--aged-gold);"><i class="fas fa-feather"></i> ${work.author}</span>
                    <span style="color: var(--ivory); opacity: 0.6;"><i class="fas fa-heart"></i> ${work.likes}</span>
                    <span style="color: var(--ivory); opacity: 0.6;"><i class="fas fa-comment"></i> ${work.comments}</span>
                    <span style="color: var(--ivory); opacity: 0.6;"><i class="fas fa-eye"></i> ${work.reads}</span>
                </div>
                <div style="font-family: var(--font-mono); font-size: 1.1rem; line-height: 2.2; color: var(--ivory); white-space: pre-line;">${work.content}</div>
                <div style="display: flex; gap: 1rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid rgba(201, 169, 97, 0.2);">
                    <button class="btn btn-primary">
                        <i class="fas fa-heart"></i>
                        Me Gusta
                    </button>
                    <button class="btn">
                        <i class="fas fa-bookmark"></i>
                        Guardar
                    </button>
                    <button class="btn">
                        <i class="fas fa-share"></i>
                        Compartir
                    </button>
                </div>
            `;
            
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        // Close Modal
        document.getElementById('modalClose').addEventListener('click', () => {
            document.getElementById('workModal').classList.remove('active');
            document.body.style.overflow = '';
        });

        // Close modal on outside click
        document.getElementById('workModal').addEventListener('click', (e) => {
            if (e.target === document.getElementById('workModal')) {
                document.getElementById('workModal').classList.remove('active');
                document.body.style.overflow = '';
            }
        });

        // Filter Buttons
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                renderWorks(btn.dataset.filter);
            });
        });

        // Theme Toggle
        document.getElementById('themeToggle').addEventListener('click', () => {
            document.body.classList.toggle('light-mode');
            const icon = document.getElementById('themeToggle').querySelector('i');
            icon.classList.toggle('fa-moon');
            icon.classList.toggle('fa-sun');
        });

        // Mobile Menu
        document.getElementById('mobileMenu').addEventListener('click', () => {
            document.getElementById('navLinks').classList.toggle('active');
        });

        // Search Functionality
        document.getElementById('searchInput').addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase();
            const cards = document.querySelectorAll('.work-card');
            
            cards.forEach(card => {
                const title = card.querySelector('.work-title').textContent.toLowerCase();
                const excerpt = card.querySelector('.work-excerpt').textContent.toLowerCase();
                const author = card.querySelector('.work-author').textContent.toLowerCase();
                
                if (title.includes(query) || excerpt.includes(query) || author.includes(query)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });

        // Form Submission
        document.getElementById('publishForm').addEventListener('submit', (e) => {
            e.preventDefault();
            alert('¡Gracias por tu contribución! Tu obra será revisada por nuestro equipo editorial y publicada en breve.');
            e.target.reset();
        });

        // Scroll Animation Observer
        function observeElements() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
        }

        // Smooth Scroll for Navigation
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                    document.getElementById('navLinks').classList.remove('active');
                }
            });
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            initEmbers();
            renderWorks();
            renderAuthors();
            renderContests();
            renderComments();
            observeElements();
        });
    </script>
</body>
</html>
