<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scriptorium - Santuario de las Palabras</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Uncial+Antiqua&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --black: #0a0a0a;
            --charcoal: #1a1a1a;
            --stone-gray: #2d2d2d;
            --dark-red: #4a0e0e;
            --blood-red: #8b1a1a;
            --aged-gold: #c9a961;
            --antique-gold: #8b7355;
            --ivory: #f5f0e6;
            --parchment: #e8dcc5;
            --mist: rgba(245, 240, 230, 0.1);
            
            --font-title: 'Uncial Antiqua', cursive;
            --font-heading: 'Cinzel', serif;
            --font-body: 'Cormorant Garamond', serif;
            --font-mono: 'EB Garamond', serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-body);
            background: var(--black);
            color: var(--ivory);
            line-height: 1.8;
            overflow-x: hidden;
            transition: all 0.3s ease;
        }

        body.light-mode {
            --black: #f5f0e6;
            --charcoal: #e8dcc5;
            --stone-gray: #d4c5b0;
            --ivory: #1a1a1a;
            --mist: rgba(26, 26, 26, 0.1);
        }

        /* Animated Background */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            overflow: hidden;
        }

        .bg-animation::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(ellipse at 20% 80%, rgba(139, 26, 26, 0.15) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 20%, rgba(201, 169, 97, 0.1) 0%, transparent 50%),
                linear-gradient(180deg, var(--black) 0%, var(--charcoal) 100%);
        }

        .fog {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 300px;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 200"><path d="M0,100 Q250,50 500,100 T1000,100 L1000,200 L0,200 Z" fill="rgba(245,240,230,0.05)"/></svg>');
            background-size: 1000px 200px;
            animation: fogMove 20s ease-in-out infinite;
            opacity: 0.5;
        }

        .fog:nth-child(2) {
            bottom: 100px;
            animation-delay: -5s;
            opacity: 0.3;
        }

        @keyframes fogMove {
            0%, 100% { transform: translateX(0); }
            50% { transform: translateX(-50px); }
        }

        .ember {
            position: absolute;
            width: 4px;
            height: 4px;
            background: var(--blood-red);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--blood-red);
            animation: emberFloat 8s ease-in-out infinite;
        }

        @keyframes emberFloat {
            0%, 100% { 
                transform: translateY(100vh) rotate(0deg);
                opacity: 0;
            }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { 
                transform: translateY(-100px) rotate(720deg);
                opacity: 0;
            }
        }

        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1.5rem 3rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            background: linear-gradient(180deg, rgba(10,10,10,0.95) 0%, rgba(10,10,10,0.8) 100%);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(201, 169, 97, 0.2);
        }

        .logo {
            font-family: var(--font-title);
            font-size: 2rem;
            color: var(--aged-gold);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.3s ease;
        }

        .logo:hover {
            color: var(--ivory);
            text-shadow: 0 0 20px rgba(201, 169, 97, 0.5);
        }

        .logo i {
            font-size: 1.5rem;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            color: var(--ivory);
            text-decoration: none;
            font-family: var(--font-heading);
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 0.5rem 0;
            position: relative;
            transition: all 0.3s ease;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--aged-gold);
            transition: width 0.3s ease;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-links a:hover {
            color: var(--aged-gold);
        }

        .nav-actions {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border: 1px solid var(--aged-gold);
            background: transparent;
            color: var(--aged-gold);
            font-family: var(--font-heading);
            font-size: 0.8rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn:hover {
            background: var(--aged-gold);
            color: var(--black);
            box-shadow: 0 0 20px rgba(201, 169, 97, 0.4);
        }

        .btn-primary {
            background: var(--dark-red);
            border-color: var(--dark-red);
            color: var(--ivory);
        }

        .btn-primary:hover {
            background: var(--blood-red);
            border-color: var(--blood-red);
            color: var(--ivory);
        }

        .theme-toggle {
            background: none;
            border: none;
            color: var(--ivory);
            cursor: pointer;
            font-size: 1.2rem;
            padding: 0.5rem;
            transition: all 0.3s ease;
        }

        .theme-toggle:hover {
            color: var(--aged-gold);
            transform: rotate(180deg);
        }

        .mobile-menu {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
        }

        .mobile-menu span {
            width: 25px;
            height: 2px;
            background: var(--ivory);
            transition: all 0.3s ease;
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 8rem 2rem 4rem;
            position: relative;
            background: linear-gradient(180deg, transparent 0%, rgba(10,10,10,0.8) 100%),
                        url('https://image.qwenlm.ai/public_source/c3d41bba-e3f6-4ac5-bbd4-b71490c16962/15b7d43d4-945a-4230-9c7c-be0a92c95ac9.png');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        .hero-content {
            max-width: 900px;
            z-index: 10;
        }

        .hero-subtitle {
            font-family: var(--font-heading);
            font-size: 1rem;
            letter-spacing: 8px;
            text-transform: uppercase;
            color: var(--aged-gold);
            margin-bottom: 2rem;
            animation: fadeInUp 1s ease 0.5s both;
        }

        .hero-title {
            font-family: var(--font-title);
            font-size: clamp(3rem, 8vw, 6rem);
            line-height: 1.1;
            margin-bottom: 2rem;
            color: var(--ivory);
            text-shadow: 0 0 40px rgba(201, 169, 97, 0.3);
            animation: fadeInUp 1s ease 0.7s both;
        }

        .hero-quote {
            font-family: var(--font-mono);
            font-style: italic;
            font-size: clamp(1.2rem, 3vw, 1.8rem);
            color: var(--ivory);
            opacity: 0.9;
            margin-bottom: 3rem;
            padding: 2rem;
            border-left: 3px solid var(--aged-gold);
            border-right: 3px solid var(--aged-gold);
            animation: fadeInUp 1s ease 0.9s both;
        }

        .hero-buttons {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            flex-wrap: wrap;
            animation: fadeInUp 1s ease 1.1s both;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .scroll-indicator {
            position: absolute;
            bottom: 3rem;
            left: 50%;
            transform: translateX(-50%);
            animation: bounce 2s ease-in-out infinite;
        }

        .scroll-indicator i {
            color: var(--aged-gold);
            font-size: 1.5rem;
        }

        @keyframes bounce {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(10px); }
        }

        /* Section Styles */
        section {
            padding: 6rem 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-subtitle {
            font-family: var(--font-heading);
            font-size: 0.9rem;
            letter-spacing: 6px;
            text-transform: uppercase;
            color: var(--aged-gold);
            margin-bottom: 1rem;
        }

        .section-title {
            font-family: var(--font-title);
            font-size: clamp(2.5rem, 5vw, 4rem);
            color: var(--ivory);
            margin-bottom: 1.5rem;
        }

        .section-divider {
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--aged-gold), transparent);
            margin: 0 auto;
        }

        /* Library Section */
        .library-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
        }

        .work-card {
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-radius: 4px;
            overflow: hidden;
            transition: all 0.4s ease;
            cursor: pointer;
        }

        .work-card:hover {
            transform: translateY(-5px);
            border-color: var(--aged-gold);
            box-shadow: 0 10px 40px rgba(201, 169, 97, 0.15);
        }

        .work-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            filter: sepia(30%) contrast(1.1);
            transition: all 0.4s ease;
        }

        .work-card:hover .work-image {
            filter: sepia(0%) contrast(1);
        }

        .work-content {
            padding: 1.5rem;
        }

        .work-category {
            font-family: var(--font-heading);
            font-size: 0.7rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--aged-gold);
            margin-bottom: 0.5rem;
        }

        .work-title {
            font-family: var(--font-heading);
            font-size: 1.4rem;
            color: var(--ivory);
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }

        .work-excerpt {
            font-family: var(--font-mono);
            font-size: 1rem;
            color: var(--ivory);
            opacity: 0.7;
            line-height: 1.8;
            margin-bottom: 1rem;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .work-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1rem;
            border-top: 1px solid rgba(201, 169, 97, 0.2);
            font-size: 0.85rem;
        }

        .work-author {
            color: var(--aged-gold);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .work-author:hover {
            color: var(--ivory);
        }

        .work-stats {
            display: flex;
            gap: 1rem;
            color: var(--ivory);
            opacity: 0.6;
        }

        .work-stats span {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        /* Filter Bar */
        .filter-bar {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 3rem;
        }

        .filter-btn {
            padding: 0.5rem 1.5rem;
            border: 1px solid rgba(201, 169, 97, 0.3);
            background: transparent;
            color: var(--ivory);
            font-family: var(--font-heading);
            font-size: 0.8rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 50px;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: var(--aged-gold);
            color: var(--black);
            border-color: var(--aged-gold);
        }

        /* Search Bar */
        .search-container {
            max-width: 600px;
            margin: 0 auto 3rem;
            position: relative;
        }

        .search-input {
            width: 100%;
            padding: 1rem 3rem 1rem 1.5rem;
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.3);
            border-radius: 50px;
            color: var(--ivory);
            font-family: var(--font-body);
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--aged-gold);
            box-shadow: 0 0 20px rgba(201, 169, 97, 0.2);
        }

        .search-icon {
            position: absolute;
            right: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--aged-gold);
        }

        /* Authors Section */
        .authors-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .author-card {
            text-align: center;
            padding: 2rem;
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-radius: 4px;
            transition: all 0.4s ease;
        }

        .author-card:hover {
            border-color: var(--aged-gold);
            transform: translateY(-5px);
        }

        .author-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--aged-gold);
            margin: 0 auto 1.5rem;
            padding: 5px;
            background: var(--charcoal);
        }

        .author-name {
            font-family: var(--font-heading);
            font-size: 1.3rem;
            color: var(--ivory);
            margin-bottom: 0.5rem;
        }

        .author-genre {
            font-family: var(--font-body);
            font-style: italic;
            color: var(--aged-gold);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .author-bio {
            font-family: var(--font-mono);
            font-size: 0.95rem;
            color: var(--ivory);
            opacity: 0.7;
            line-height: 1.8;
            margin-bottom: 1.5rem;
        }

        .author-stats {
            display: flex;
            justify-content: center;
            gap: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(201, 169, 97, 0.2);
        }

        .stat {
            text-align: center;
        }

        .stat-value {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            color: var(--aged-gold);
        }

        .stat-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--ivory);
            opacity: 0.6;
        }

        /* Magazine Section */
        .magazine-featured {
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.3);
            border-radius: 8px;
            overflow: hidden;
            display: grid;
            grid-template-columns: 1fr 1fr;
            margin-bottom: 3rem;
        }

        .magazine-image {
            width: 100%;
            height: 100%;
            min-height: 400px;
            object-fit: cover;
        }

        .magazine-content {
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .magazine-label {
            font-family: var(--font-heading);
            font-size: 0.8rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--blood-red);
            margin-bottom: 1rem;
        }

        .magazine-title {
            font-family: var(--font-title);
            font-size: 2.5rem;
            color: var(--ivory);
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

        .magazine-excerpt {
            font-family: var(--font-mono);
            font-size: 1.1rem;
            color: var(--ivory);
            opacity: 0.8;
            line-height: 1.9;
            margin-bottom: 2rem;
        }

        .contests-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .contest-card {
            background: linear-gradient(135deg, var(--charcoal) 0%, var(--stone-gray) 100%);
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-radius: 8px;
            padding: 2rem;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .contest-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--dark-red), var(--aged-gold));
        }

        .contest-card:hover {
            transform: translateY(-5px);
            border-color: var(--aged-gold);
        }

        .contest-deadline {
            font-family: var(--font-heading);
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--blood-red);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .contest-title {
            font-family: var(--font-heading);
            font-size: 1.4rem;
            color: var(--ivory);
            margin-bottom: 1rem;
        }

        .contest-prize {
            font-family: var(--font-mono);
            font-size: 1rem;
            color: var(--aged-gold);
            margin-bottom: 1.5rem;
        }

        /* Editor Section */
        .editor-section {
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-radius: 8px;
            padding: 3rem;
            margin-top: 3rem;
        }

        .editor-header {
            display: flex;
            align-items: center;
            gap: 2rem;
            margin-bottom: 2rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid rgba(201, 169, 97, 0.2);
        }

        .editor-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--aged-gold);
        }

        .editor-info h3 {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            color: var(--ivory);
            margin-bottom: 0.5rem;
        }

        .editor-info p {
            font-family: var(--font-body);
            font-style: italic;
            color: var(--aged-gold);
        }

        .editor-note {
            font-family: var(--font-mono);
            font-size: 1.1rem;
            color: var(--ivory);
            opacity: 0.9;
            line-height: 2;
            padding-left: 2rem;
            border-left: 3px solid var(--aged-gold);
        }

        /* Write Section */
        .write-section {
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.3);
            border-radius: 8px;
            padding: 3rem;
            max-width: 900px;
            margin: 0 auto;
        }

        .editor-container {
            margin-top: 2rem;
        }

        .editor-toolbar {
            display: flex;
            gap: 0.5rem;
            padding: 1rem;
            background: var(--stone-gray);
            border-radius: 8px 8px 0 0;
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-bottom: none;
            flex-wrap: wrap;
        }

        .toolbar-btn {
            padding: 0.5rem 0.75rem;
            background: transparent;
            border: none;
            color: var(--ivory);
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .toolbar-btn:hover {
            background: var(--aged-gold);
            color: var(--black);
        }

        .editor-textarea {
            width: 100%;
            min-height: 400px;
            padding: 1.5rem;
            background: var(--black);
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-radius: 0 0 8px 8px;
            color: var(--ivory);
            font-family: var(--font-mono);
            font-size: 1.1rem;
            line-height: 2;
            resize: vertical;
        }

        .editor-textarea:focus {
            outline: none;
            border-color: var(--aged-gold);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            font-family: var(--font-heading);
            font-size: 0.85rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--aged-gold);
            margin-bottom: 0.5rem;
        }

        .form-input,
        .form-select {
            width: 100%;
            padding: 1rem;
            background: var(--black);
            border: 1px solid rgba(201, 169, 97, 0.3);
            border-radius: 4px;
            color: var(--ivory);
            font-family: var(--font-body);
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-input:focus,
        .form-select:focus {
            outline: none;
            border-color: var(--aged-gold);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        /* Comments Section */
        .comments-section {
            margin-top: 3rem;
            padding-top: 3rem;
            border-top: 1px solid rgba(201, 169, 97, 0.2);
        }

        .comment {
            display: flex;
            gap: 1.5rem;
            padding: 1.5rem 0;
            border-bottom: 1px solid rgba(201, 169, 97, 0.1);
        }

        .comment-avatar {
            width: 50px;
