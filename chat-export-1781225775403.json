        .theme-toggle:hover {
            color: var(--aged-gold);
            transform: rotate(180deg);
        }

        .mobile-menu {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
        }

        .mobile-menu span {
            width: 25px;
            height: 2px;
            background: var(--ivory);
            transition: all 0.3s ease;
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 8rem 2rem 4rem;
            position: relative;
            background: linear-gradient(180deg, transparent 0%, rgba(10,10,10,0.8) 100%),
                        url('https://image.qwenlm.ai/public_source/abc7554c-49a0-4af4-ba6c-7f7dc6556070/1828516bb-6a21-443e-ad93-3654ed3d439a.png');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        .hero-content {
            max-width: 900px;
            z-index: 10;
        }

        .hero-subtitle {
            font-family: var(--font-heading);
            font-size: 1rem;
            letter-spacing: 8px;
            text-transform: uppercase;
            color: var(--aged-gold);
            margin-bottom: 2rem;
            animation: fadeInUp 1s ease 0.5s both;
        }

        .hero-title {
            font-family: var(--font-title);
            font-size: clamp(3rem, 8vw, 6rem);
            line-height: 1.1;
            margin-bottom: 2rem;
            color: var(--ivory);
            text-shadow: 0 0 40px rgba(201, 169, 97, 0.3);
            animation: fadeInUp 1s ease 0.7s both;
        }

        .hero-quote {
            font-family: var(--font-mono);
            font-style: italic;
            font-size: clamp(1.2rem, 3vw, 1.8rem);
            color: var(--ivory);
            opacity: 0.9;
            margin-bottom: 3rem;
            padding: 2rem;
            border-left: 3px solid var(--aged-gold);
            border-right: 3px solid var(--aged-gold);
            animation: fadeInUp 1s ease 0.9s both;
        }

        .hero-buttons {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            flex-wrap: wrap;
            animation: fadeInUp 1s ease 1.1s both;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .scroll-indicator {
            position: absolute;
            bottom: 3rem;
            left: 50%;
            transform: translateX(-50%);
            animation: bounce 2s ease-in-out infinite;
        }

        .scroll-indicator i {
            color: var(--aged-gold);
            font-size: 1.5rem;
        }

        @keyframes bounce {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(10px); }
        }

        /* Section Styles */
        section {
            padding: 6rem 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-subtitle {
            font-family: var(--font-heading);
            font-size: 0.9rem;
            letter-spacing: 6px;
            text-transform: uppercase;
            color: var(--aged-gold);
            margin-bottom: 1rem;
        }

        .section-title {
            font-family: var(--font-title);
            font-size: clamp(2.5rem, 5vw, 4rem);
            color: var(--ivory);
            margin-bottom: 1.5rem;
        }

        .section-divider {
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--aged-gold), transparent);
            margin: 0 auto;
        }

        /* Library Section */
        .library-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
        }

        .work-card {
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-radius: 4px;
            overflow: hidden;
            transition: all 0.4s ease;
            cursor: pointer;
        }

        .work-card:hover {
            transform: translateY(-5px);
            border-color: var(--aged-gold);
            box-shadow: 0 10px 40px rgba(201, 169, 97, 0.15);
        }

        .work-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            filter: sepia(30%) contrast(1.1);
            transition: all 0.4s ease;
        }

        .work-card:hover .work-image {
            filter: sepia(0%) contrast(1);
        }

        .work-content {
            padding: 1.5rem;
        }

        .work-category {
            font-family: var(--font-heading);
            font-size: 0.7rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--aged-gold);
            margin-bottom: 0.5rem;
        }

        .work-title {
            font-family: var(--font-heading);
            font-size: 1.4rem;
            color: var(--ivory);
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }

        .work-excerpt {
            font-family: var(--font-mono);
            font-size: 1rem;
            color: var(--ivory);
            opacity: 0.7;
            line-height: 1.8;
            margin-bottom: 1rem;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .work-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1rem;
            border-top: 1px solid rgba(201, 169, 97, 0.2);
            font-size: 0.85rem;
        }

        .work-author {
            color: var(--aged-gold);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.3s ease;
        }

        .work-author:hover {
            color: var(--ivory);
        }

        .work-stats {
            display: flex;
            gap: 1rem;
            color: var(--ivory);
            opacity: 0.6;
        }

        .work-stats span {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        /* Filter Bar */
        .filter-bar {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 3rem;
        }

        .filter-btn {
            padding: 0.5rem 1.5rem;
            border: 1px solid rgba(201, 169, 97, 0.3);
            background: transparent;
            color: var(--ivory);
            font-family: var(--font-heading);
            font-size: 0.8rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 50px;
        }

        .filter-btn:hover,
        .filter-btn.active {
            background: var(--aged-gold);
            color: var(--black);
            border-color: var(--aged-gold);
        }

        /* Search Bar */
        .search-container {
            max-width: 600px;
            margin: 0 auto 3rem;
            position: relative;
        }

        .search-input {
            width: 100%;
            padding: 1rem 3rem 1rem 1.5rem;
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.3);
            border-radius: 50px;
            color: var(--ivory);
            font-family: var(--font-body);
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--aged-gold);
            box-shadow: 0 0 20px rgba(201, 169, 97, 0.2);
        }

        .search-icon {
            position: absolute;
            right: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--aged-gold);
        }

        /* Authors Section */
        .authors-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .author-card {
            text-align: center;
            padding: 2rem;
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-radius: 4px;
            transition: all 0.4s ease;
        }

        .author-card:hover {
            border-color: var(--aged-gold);
            transform: translateY(-5px);
        }

        .author-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--aged-gold);
            margin: 0 auto 1.5rem;
            padding: 5px;
            background: var(--charcoal);
        }

        .author-name {
            font-family: var(--font-heading);
            font-size: 1.3rem;
            color: var(--ivory);
            margin-bottom: 0.5rem;
        }

        .author-genre {
            font-family: var(--font-body);
            font-style: italic;
            color: var(--aged-gold);
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .author-bio {
            font-family: var(--font-mono);
            font-size: 0.95rem;
            color: var(--ivory);
            opacity: 0.7;
            line-height: 1.8;
            margin-bottom: 1.5rem;
        }

        .author-stats {
            display: flex;
            justify-content: center;
            gap: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(201, 169, 97, 0.2);
        }

        .stat {
            text-align: center;
        }

        .stat-value {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            color: var(--aged-gold);
        }

        .stat-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--ivory);
            opacity: 0.6;
        }

        /* Magazine Section */
        .magazine-featured {
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.3);
            border-radius: 8px;
            overflow: hidden;
            display: grid;
            grid-template-columns: 1fr 1fr;
            margin-bottom: 3rem;
        }

        .magazine-image {
            width: 100%;
            height: 100%;
            min-height: 400px;
            object-fit: cover;
        }

        .magazine-content {
            padding: 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .magazine-label {
            font-family: var(--font-heading);
            font-size: 0.8rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--blood-red);
            margin-bottom: 1rem;
        }

        .magazine-title {
            font-family: var(--font-title);
            font-size: 2.5rem;
            color: var(--ivory);
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

        .magazine-excerpt {
            font-family: var(--font-mono);
            font-size: 1.1rem;
            color: var(--ivory);
            opacity: 0.8;
            line-height: 1.9;
            margin-bottom: 2rem;
        }

        .contests-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .contest-card {
            background: linear-gradient(135deg, var(--charcoal) 0%, var(--stone-gray) 100%);
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-radius: 8px;
            padding: 2rem;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .contest-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--dark-red), var(--aged-gold));
        }

        .contest-card:hover {
            transform: translateY(-5px);
            border-color: var(--aged-gold);
        }

        .contest-deadline {
            font-family: var(--font-heading);
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--blood-red);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .contest-title {
            font-family: var(--font-heading);
            font-size: 1.4rem;
            color: var(--ivory);
            margin-bottom: 1rem;
        }

        .contest-prize {
            font-family: var(--font-mono);
            font-size: 1rem;
            color: var(--aged-gold);
            margin-bottom: 1.5rem;
        }

        /* Editor Section */
        .editor-section {
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-radius: 8px;
            padding: 3rem;
            margin-top: 3rem;
        }

        .editor-header {
            display: flex;
            align-items: center;
            gap: 2rem;
            margin-bottom: 2rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid rgba(201, 169, 97, 0.2);
        }

        .editor-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--aged-gold);
        }

        .editor-info h3 {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            color: var(--ivory);
            margin-bottom: 0.5rem;
        }

        .editor-info p {
            font-family: var(--font-body);
            font-style: italic;
            color: var(--aged-gold);
        }

        .editor-note {
            font-family: var(--font-mono);
            font-size: 1.1rem;
            color: var(--ivory);
            opacity: 0.9;
            line-height: 2;
            padding-left: 2rem;
            border-left: 3px solid var(--aged-gold);
        }

        /* Write Section */
        .write-section {
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.3);
            border-radius: 8px;
            padding: 3rem;
            max-width: 900px;
            margin: 0 auto;
        }

        .editor-container {
            margin-top: 2rem;
        }

        .editor-toolbar {
            display: flex;
            gap: 0.5rem;
            padding: 1rem;
            background: var(--stone-gray);
            border-radius: 8px 8px 0 0;
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-bottom: none;
            flex-wrap: wrap;
        }

        .toolbar-btn {
            padding: 0.5rem 0.75rem;
            background: transparent;
            border: none;
            color: var(--ivory);
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .toolbar-btn:hover {
            background: var(--aged-gold);
            color: var(--black);
        }

        .editor-textarea {
            width: 100%;
            min-height: 400px;
            padding: 1.5rem;
            background: var(--black);
            border: 1px solid rgba(201, 169, 97, 0.2);
            border-radius: 0 0 8px 8px;
            color: var(--ivory);
            font-family: var(--font-mono);
            font-size: 1.1rem;
            line-height: 2;
            resize: vertical;
        }

        .editor-textarea:focus {
            outline: none;
            border-color: var(--aged-gold);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            font-family: var(--font-heading);
            font-size: 0.85rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--aged-gold);
            margin-bottom: 0.5rem;
        }

        .form-input,
        .form-select {
            width: 100%;
            padding: 1rem;
            background: var(--black);
            border: 1px solid rgba(201, 169, 97, 0.3);
            border-radius: 4px;
            color: var(--ivory);
            font-family: var(--font-body);
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-input:focus,
        .form-select:focus {
            outline: none;
            border-color: var(--aged-gold);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        /* Comments Section */
        .comments-section {
            margin-top: 3rem;
            padding-top: 3rem;
            border-top: 1px solid rgba(201, 169, 97, 0.2);
        }

        .comment {
            display: flex;
            gap: 1.5rem;
            padding: 1.5rem 0;
            border-bottom: 1px solid rgba(201, 169, 97, 0.1);
        }

        .comment-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--aged-gold);
        }

        .comment-content {
            flex: 1;
        }

        .comment-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.75rem;
        }

        .comment-author {
            font-family: var(--font-heading);
            font-size: 1rem;
            color: var(--aged-gold);
        }

        .comment-date {
            font-size: 0.8rem;
            color: var(--ivory);
            opacity: 0.5;
        }

        .comment-text {
            font-family: var(--font-mono);
            font-size: 1rem;
            color: var(--ivory);
            opacity: 0.9;
            line-height: 1.8;
        }

        .comment-actions {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
        }

        .comment-action {
            background: none;
            border: none;
            color: var(--ivory);
            opacity: 0.6;
            cursor: pointer;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 0.3rem;
            transition: all 0.3s ease;
        }

        .comment-action:hover {
            opacity: 1;
            color: var(--aged-gold);
        }

        /* Footer */
        footer {
            background: var(--charcoal);
            border-top: 1px solid rgba(201, 169, 97, 0.3);
            padding: 4rem 2rem 2rem;
            margin-top: 4rem;
        }

        .footer-content {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 3rem;
        }

        .footer-section h4 {
            font-family: var(--font-heading);
            font-size: 1.1rem;
            color: var(--aged-gold);
            margin-bottom: 1.5rem;
            letter-spacing: 2px;
        }

        .footer-section p,
        .footer-section a {
            font-family: var(--font-mono);
            font-size: 0.95rem;
            color: var(--ivory);
            opacity: 0.7;
            line-height: 2;
            text-decoration: none;
            display: block;
            transition: all 0.3s ease;
        }

        .footer-section a:hover {
            opacity: 1;
            color: var(--aged-gold);
        }

        .social-links {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
        }

        .social-link {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(201, 169, 97, 0.3);
            border-radius: 50%;
            color: var(--aged-gold);
            transition: all 0.3s ease;
        }

        .social-link:hover {
            background: var(--aged-gold);
            color: var(--black);
            border-color: var(--aged-gold);
        }

        .footer-bottom {
            max-width: 1400px;
            margin: 3rem auto 0;
            padding-top: 2rem;
            border-top: 1px solid rgba(201, 169, 97, 0.2);
            text-align: center;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--ivory);
            opacity: 0.5;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 2rem;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: var(--charcoal);
            border: 1px solid rgba(201, 169, 97, 0.3);
            border-radius: 8px;
            max-width: 800px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
        }

        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: none;
            border: none;
            color: var(--ivory);
            font-size: 1.5rem;
            cursor: pointer;
            z-index: 10;
            transition: all 0.3s ease;
        }

        .modal-close:hover {
            color: var(--aged-gold);
            transform: rotate(90deg);
        }

        .modal-body {
            padding: 3rem;
        }

        /* Responsive */
        @media (max-width: 992px) {
            .magazine-featured {
                grid-template-columns: 1fr;
            }

            .magazine-image {
                min-height: 300px;
            }

            .editor-header {
                flex-direction: column;
                text-align: center;
            }
        }

        @media (max-width: 768px) {
            nav {
                padding: 1rem 1.5rem;
            }

            .nav-links {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                width: 100%;
                background: var(--charcoal);
                flex-direction: column;
                padding: 2rem;
                gap: 1.5rem;
                border-bottom: 1px solid rgba(201, 169, 97, 0.2);
            }

            .nav-links.active {
                display: flex;
            }

            .mobile-menu {
                display: flex;
            }

            .hero {
                padding: 6rem 1.5rem 3rem;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .library-grid,
            .authors-grid,
            .contests-grid {
                grid-template-columns: 1fr;
            }

            section {
                padding: 4rem 1.5rem;
            }
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--black);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--aged-gold);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--blood-red);
        }

        /* Animations */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.6s ease;
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
<body>
    <!-- Background Animation -->
    <div class="bg-animation" id="bgAnimation">
        <div class="fog"></div>
        <div class="fog"></div>
    </div>

    <!-- Navigation -->
    <nav>
        <a href="#" class="logo">
            <i class="fas fa-feather-alt"></i>
            Scriptorium
        </a>
        <ul class="nav-links" id="navLinks">
            <li><a href="#inicio">Inicio</a></li>
            <li><a href="#biblioteca">Biblioteca</a></li>
            <li><a href="#autores">Autores</a></li>
            <li><a href="#revista">Revista</a></li>
            <li><a href="#concursos">Concursos</a></li>
            <li><a href="#escribir">Escribir</a></li>
        </ul>
        <div class="nav-actions">
            <button class="theme-toggle" id="themeToggle" title="Cambiar tema">
                <i class="fas fa-moon"></i>
            </button>
